# Environment Variables (copy to .env.local for local dev)

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=dev

# Security
AUTH_SECRET=change-me-super-secret-32-chars-minimum
AUTH_SALT_ROUNDS=12

# Database (Neon PostgreSQL)
# Runtime connection. Use the pooled (PgBouncer-compatible) endpoint for `DATABASE_URL`.
DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require
# Direct (non-pooled) connection used by Prisma Migrate only. Required when the
# runtime URL points to a pooler (e.g. Neon `-pooler` hosts) because migrations
# need session advisory locks. For Neon, remove `-pooler` from the host.
DIRECT_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require

# Admin bootstrap (env-only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Portfolio Admin

# Site bootstrap (env-only)
SITE_TITLE=Your Name - Portfolio
SITE_SUBTITLE=Full Stack Developer
SITE_DESCRIPTION=Portfolio website powered by Next.js
THEME_ID=professional-dark
PRIMARY_EMAIL=admin@example.com
SECONDARY_EMAIL=
LOCATION=
TIMEZONE=

# Hero (optional)
HERO_GREETING=Hello, I am
HERO_SUBTITLE=Creative Developer
HERO_DESCRIPTION=I build thoughtful digital experiences.
HERO_PRIMARY_LABEL=View Work
HERO_PRIMARY_URL=/portfolio
HERO_SECONDARY_LABEL=Contact Me
HERO_SECONDARY_URL=/home#contact

# SEO (optional)
SEO_TITLE=Your Name - Portfolio
SEO_TITLE_TEMPLATE=%s | Portfolio
SEO_DESCRIPTION=Portfolio website powered by Next.js
SEO_KEYWORDS=portfolio,developer,designer
SEO_SITE_URL=http://localhost:3000
SEO_METADATA_BASE=http://localhost:3000
SEO_OG_IMAGE=
SEO_TWITTER_HANDLE=

# Content toggles
SEED_SAMPLE_DATA=false
NEXT_PUBLIC_SEED_SAMPLE_DATA=false

# JSON blobs (optional)
SOCIAL_LINKS_JSON=[]
CONTACT_TITLE=
CONTACT_SUBTITLE=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# E2E / Playwright
# Optional dedicated test database. Falls back to DATABASE_URL when omitted.
PLAYWRIGHT_DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require
# Optional direct (non-pooled) connection for the isolated E2E database.
# Falls back to DIRECT_URL, then to PLAYWRIGHT_DATABASE_URL with `-pooler` stripped.
PLAYWRIGHT_DIRECT_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require
# Used when explicitly reusing an already-running dev server.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# Used by the isolated Playwright bootstrap when it provisions its own app instance.
PLAYWRIGHT_ISOLATED_BASE_URL=http://127.0.0.1:3100
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=change-me-now
